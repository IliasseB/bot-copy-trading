# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=trading_bot

# Comma-separated list of group/channel IDs or usernames to monitor
# Example: -1001234567890,-1009876543210,@tradinggroup
TELEGRAM_GROUP_IDS=-1001234567890

# =============================================================================
# METATRADER 5 CONFIGURATION
# =============================================================================
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
MT5_PATH=C:\Program Files\Pepperstone MetaTrader 5\terminal64.exe
MT5_TIMEOUT=60000
MT5_ALLOW_REAL=false                  # Mettre true UNIQUEMENT pour un compte réel

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
RISK_MAX_PERCENT_PER_TRADE=1.0        # Max % of account balance per trade
RISK_MAX_DAILY_LOSS_PERCENT=5.0       # Max daily loss % before emergency stop
RISK_MAX_SIMULTANEOUS_TRADES=5        # Max open trades at once
RISK_MAX_SPREAD_POINTS=30             # Max allowed spread in points
RISK_MAX_SLIPPAGE_POINTS=20           # Max allowed slippage in points
RISK_DEFAULT_LOT_SIZE=0.01            # Fallback lot size if calculation fails
RISK_FIXED_LOT=0.01                   # Lot fixe (0 = calcul auto selon le risque)
RISK_MAX_LOT=0.10                     # Plafond dur du lot
RISK_MARGIN_SAFETY_RATIO=0.8          # Part de la marge libre utilisable
RISK_LOT_PER_TP=0.01                  # Lot PAR TP : 1 TP → 1 position, TP1+TP2 → 2 positions (0 = désactivé)
RISK_MAX_ENTRY_DISTANCE_PERCENT=1.0   # Entrée à plus de X % du prix = faute de frappe → signal refusé
RISK_TRADING_HOURS=                   # ex: 08:00-22:00 (heure du PC) — vide = toujours
RISK_TRADING_DAYS=                    # ex: 1-5 = lundi→vendredi — vide = tous les jours
RISK_MAX_TRADES_PER_DAY=0             # nombre max de signaux tradés par jour (0 = illimité)

# =============================================================================
# DATABASE - POSTGRESQL
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql://trading_user:strong_password_here@postgres:5432/trading_bot

# =============================================================================
# DATABASE - REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here
REDIS_DB=0
REDIS_URL=redis://:redis_password_here@redis:6379/0

# =============================================================================
# BOT CONFIGURATION
# =============================================================================
BOT_ENV=production                    # production | development
BOT_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
BOT_MAX_SIGNAL_AGE_SECONDS=30         # Ignore signals older than this
BOT_DEDUP_WINDOW_SECONDS=60           # Deduplication window
BOT_SIGNAL_CONFIDENCE_THRESHOLD=0.7   # Minimum confidence score to execute
BOT_MAX_EDIT_AGE_SECONDS=900          # Signal corrigé plus de X s après publication → pas de nouveau trade

# Messages de gestion du canal (BE, "TP1 touché", "CLÔTUREZ TP2", "SÉCURISEZ 50%"...)
BOT_UPDATE_PARTIAL_CLOSE=true         # appliquer les clôtures partielles ("SÉCURISEZ 50%") sur MT5
BOT_UPDATE_NO_REPLY_FALLBACK=true     # ordre clair posté sans "répondre" → appliqué au dernier signal ouvert
BOT_UPDATE_MAX_DISTANCE_PERCENT=3.0   # SL/TP reçu à plus de X % de l'entrée = faute de frappe → ignoré
BOT_NOTIFY=false                      # true = le bot t'écrit dans tes Messages enregistrés Telegram
BOT_DAILY_REPORT_HOUR=22              # heure du récap du jour (-1 = jamais)
BOT_PENDING_EXPIRY_MINUTES=0          # annule un ordre en attente non déclenché après X min (0 = jamais, 30-60 conseillé)

# =============================================================================
# SYMBOLS MAPPING
# =============================================================================
# Maps aliases to broker's exact symbol name
BOT_SYMBOL_MAP={"GOLD":"XAUUSD","XAU":"XAUUSD","XAUUSD":"XAUUSD"}

# =============================================================================
# PERFORMANCE
# =============================================================================
EXECUTION_TIMEOUT_MS=5000             # Max ms to wait for MT5 execution
EXECUTION_RECONNECT_DELAY_SECONDS=5
EXECUTION_RECONNECT_MAX_ATTEMPTS=10
EXECUTION_BE_OFFSET_POINTS=0          # BE à entrée + X points (or : 10 = 0.10$)
